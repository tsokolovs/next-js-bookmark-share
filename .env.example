# A private bookmark collection with email invitations for readers.
# Save local values in .env. Real tokens and passwords belong outside source control.
# To preview messages locally, run the dev server with MAIL_MODE=log. Sending setup is in docs/email-setup.md.

APP_URL=http://localhost:3000 # Use the collection site origin here; emailed access links are built from it.
HOST=127.0.0.1 # Next.js ignores HOST; use the --hostname option on npm start to change its bind address.
PORT=3000 # Production port number. A reverse proxy may expose a different public port.
DB_PATH=.data/app.sqlite # Saved bookmarks, reader access tokens, and invitation emails; SQLite file relative to the app directory. Preserve it across deployments.
ADMIN_PASSWORD= # To add bookmarks and invite readers, use username admin with your own random password (minimum 16 characters).
OWNER_EMAIL=owner@example.com # Not used for collection access links; this setting can be left empty.
REVIEWER_EMAIL=reviewer@example.com # Optional to clear: collection access links are routed without this reviewer setting.
MAIL_MODE=sandbox # Choose sandbox to inspect collection access links, production to send, or log for a development preview.
MAIL_FROM=sender@example.com # Use your verified Mailtrap domain for the production sender of collection access links.
MAILTRAP_PRODUCTION_TOKEN= # Your Mailtrap transactional send token for collection access links; leave empty for sandbox or log mode.
MAILTRAP_SANDBOX_TOKEN= # Your inbox integration provides this Sandbox API token; leave blank in log mode.
MAILTRAP_INBOX_ID= # Number identifying the Sandbox inbox for collection access links; available in its integration settings.
